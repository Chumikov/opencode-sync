{
  "name": "@chumikov/opencode-sync",
  "version": "1.1.2",
  "description": "Git-based session synchronization for OpenCode",
  "author": "Chumikov Sec",
  "license": "MIT",
  "type": "module",
  "bin": {
    "opencode-sync": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Chumikov/opencode-sync.git"
  },
  "bugs": {
    "url": "https://github.com/Chumikov/opencode-sync/issues"
  },
  "homepage": "https://github.com/Chumikov/opencode-sync#readme",
  "keywords": [
    "opencode",
    "sync",
    "git",
    "sessions",
    "cli"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check src/",
    "lint:fix": "biome check --fix --unsafe src/",
    "prepublishOnly": "npm run build && node -e \"const{readdirSync,rmSync,statSync}=require('fs');const{join}=require('path');(function rm(p){for(const f of readdirSync(p)){const fp=join(p,f);statSync(fp).isDirectory()?rm(fp):f.includes('.test.')&&rmSync(fp)}})('dist');rmSync(join('dist','__tests__'),{recursive:true,force:true})\"",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@clack/prompts": "^1.2.0",
    "commander": "^13.1.0",
    "figlet": "^1.11.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@types/figlet": "^1.7.0",
    "@types/node": "^22.15.0",
    "@vitest/coverage-v8": "^4.1.5",
    "husky": "^9.1.7",
    "typescript": "^5.8.3",
    "vitest": "^4.1.5"
  }
}
