{
  "name": "opencode-sync",
  "version": "1.1.0",
  "description": "Git-based session synchronization for OpenCode",
  "type": "module",
  "bin": {
    "opencode-sync": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check src/",
    "lint:fix": "biome check --fix --unsafe src/",
    "prepublishOnly": "npm run build",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@clack/prompts": "^1.2.0",
    "commander": "^13.1.0",
    "figlet": "^1.11.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@types/figlet": "^1.7.0",
    "@types/node": "^22.15.0",
    "@vitest/coverage-v8": "^4.1.5",
    "husky": "^9.1.7",
    "typescript": "^5.8.3",
    "vitest": "^4.1.5"
  }
}
